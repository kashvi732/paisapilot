NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
FRONTEND_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# Session cookie settings. Production requires COOKIE_SECURE=true;
# COOKIE_SAME_SITE=none (cross-site frontend) also requires COOKIE_SECURE=true.
COOKIE_NAME=paisapilot_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
JWT_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# Number of reverse-proxy hops to trust for client IPs (0 when not behind a proxy).
TRUST_PROXY=0
